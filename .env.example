# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Either set DATABASE_URL (what most hosts — Render, Railway, Heroku,
# Supabase, Neon — give you as a single connection string) or the
# discrete vars below. DATABASE_URL takes precedence if both are set.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ryda
# Most hosted Postgres requires this — leave off for local Postgres, which has no TLS listener.
DB_SSL=false
# Turn OFF in production and use migrations instead.
DB_SYNCHRONIZE=true

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Pricing (defaults tuned for NGN — adjust per market)
DEFAULT_CURRENCY=NGN
PER_KM_RATE=120
MINIMUM_FARE=700
BOOKING_FEE=100
# Tiered time-based fare: first RIDE_TIER_MINUTES of estimated trip
# duration cost RIDE_TIER_BASE_FARE flat; each additional block of
# RIDE_TIER_MINUTES (or part thereof) adds RIDE_TIER_INCREMENT_FARE.
RIDE_TIER_MINUTES=5
RIDE_TIER_BASE_FARE=1700
RIDE_TIER_INCREMENT_FARE=700

# Paystack (leave blank to run in simulated dev mode)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CARD_VERIFY_KOBO=5000

# Referral bonuses (NGN)
REFERRAL_REFEREE_BONUS=500
REFERRAL_REFERRER_BONUS=500

# Notifications (leave blank to run in simulated dev mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@ryda.example
FCM_SERVER_KEY=

# Google Maps (leave blank to use Haversine fallback)
GOOGLE_MAPS_API_KEY=

# Pricing extensions
NIGHT_START_HOUR=22
NIGHT_END_HOUR=5
NIGHT_MULTIPLIER=1.15
AIRPORT_FEE=1000
FREE_WAIT_MINUTES=5
PER_MINUTE_WAIT_RATE=30
CANCELLATION_FEE=500

# Dispatch offers
DISPATCH_OFFER_TIMEOUT_SECONDS=60
DISPATCH_OFFER_RADIUS_KM=8
DISPATCH_EXPIRY_CHECK_MS=15000

# Logistics pricing
LOGISTICS_BASE_FARE=300
LOGISTICS_PER_KM_RATE=100
LOGISTICS_PER_KG_RATE=50
LOGISTICS_MINIMUM_FARE=500

# File storage (defaults to local disk if the chosen cloud driver isn't configured)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_LOCAL_BASE_URL=http://localhost:3000/api/v1/storage/files
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Search (defaults to Postgres full-text if OpenSearch isn't configured)
SEARCH_DRIVER=postgres
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Redis / BullMQ (required — backs notification delivery, scheduled-ride
# activation, and reconciliation auto-settlement)
# Either set REDIS_URL (what most hosts — Render, Railway, Upstash — give
# you as a single connection string) or the three discrete vars below.
# REDIS_URL takes precedence if both are set.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Scheduled rides
SCHEDULED_RIDE_LEAD_MINUTES=10

# Driver incentives
DEFAULT_STREAK_REWARD=2000

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ryda-backend
LOG_LEVEL=info
